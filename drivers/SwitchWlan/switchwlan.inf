;
; switchwlan.inf - Nintendo Switch Wi-Fi (BCM4356 on Tegra210 PCIe), WiFiCx client
; Needs Windows 11 22H2 or later (WiFiCx), UEFI R405 or later (ACPI\SWOA0D01)
; and the user's own BCM4356 firmware in System32\drivers\switchwifi.
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = Net
ClassGuid   = {4d36e972-e325-11ce-bfc1-08002be10318}
Provider    = %Mfg%
CatalogFile = switchwlan.cat
DriverVer   = 11/07/2026,0.6.12.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
switchwlan.sys = 1

[Manufacturer]
%Mfg% = Std, NTarm64

[Std.NTarm64]
%DeviceDesc% = SwWlan_Inst, ACPI\SWOA0D01

[SwWlan_Inst.NT]
CopyFiles           = SwWlan_Copy
Characteristics     = 0x84      ; NCF_HAS_UI | NCF_PHYSICAL
BusType             = 0         ; Internal
AddReg              = SwWlan_AddReg
*IfType             = 71        ; IF_TYPE_IEEE80211
*MediaType          = 16        ; NdisMediumNative802_11
*PhysicalMediaType  = 9         ; NdisPhysicalMediumNative802_11

[SwWlan_Copy]
switchwlan.sys

[SwWlan_AddReg]
HKR, Ndi,                   Service,    0, "switchwlan"
HKR, Ndi\Interfaces,        UpperRange, 0, "ndis5"
HKR, Ndi\Interfaces,        LowerRange, 0, "wlan,ethernet"
HKR, NetworkInterface, *IfConnectorPresent, 0x00010001, 1
HKR, NetworkInterface, *ConnectionType,     0x00010001, 1
HKR, NetworkInterface, *DirectionType,      0x00010001, 0
HKR, NetworkInterface, *AccessType,         0x00010001, 2
HKR, NetworkInterface, *HardwareLoopback,   0x00010001, 0
HKR, , NumberOfNetworkInterfaces, 0x00010001, 5

[SwWlan_Inst.NT.Services]
AddService = switchwlan, 0x00000002, SwWlan_Service

[SwWlan_Service]
DisplayName   = %ServiceDesc%
ServiceType   = 1
StartType     = 3
ErrorControl  = 1
ServiceBinary = %13%\switchwlan.sys

[SwWlan_Inst.NT.Wdf]
KmdfService = switchwlan, SwWlan_WdfSection

[SwWlan_WdfSection]
KmdfLibraryVersion = 1.33

[Strings]
Mfg         = "SwitchWOA"
DiskName    = "SwitchWOA Wi-Fi"
DeviceDesc  = "Nintendo Switch Wi-Fi (BCM4356)"
ServiceDesc = "Nintendo Switch Wi-Fi (WiFiCx)"
